# ========================================================
# Konfigurasi Environment Variables LaporKampus
# ========================================================

# --------------------------------------------------------
# PILIHAN A: Database Neon Serverless PostgreSQL (Direkomendasikan bersama Vercel)
# Dapatkan connection string dari dashboard neon.tech (Project Dashboard -> Connection Details)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# --------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_secret@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------
# PILIHAN B: Supabase (Alternatif Postgres + Supabase Storage)
# Dapatkan dari Project Settings -> API di Supabase Dashboard
# --------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------------------------------
# Auth & Session Security (WAJIB)
# Secret Key untuk penandatanganan JSON Web Token (JWT) sesi auth
# Gunakan string acak minimal 32 karakter
# --------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-lapor-kampus-min-32-chars-long-2026

# (Opsional) URL aplikasi saat dideploy
NEXT_PUBLIC_APP_URL=http://localhost:3000
